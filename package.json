{
  "name": "mcp-to-cli",
  "private": true,
  "workspaces": [
    "packages/*",
    "plugins/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "cli": "bun apps/cli/src/main.ts",
    "generate": "bun apps/cli/src/main.ts generate",
    "test": "turbo run test && bun test scripts",
    "typecheck": "turbo run typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "oxlint --deny-warnings . && bun scripts/check-code-rules.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.2"
}
