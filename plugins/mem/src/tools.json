      "description": "Read one original record page. Pass a recordId from recall or start, then pass the returned cursor for the next page.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "description": "Cursor from the previous response.",
            "type": "string"
          },
          "maxBytes": {
            "description": "Byte limit for the whole mem JSON response. Default: 8192.",
            "maximum": 20480,
            "minimum": 512,
            "type": "integer"
          },
          "record": {
            "description": "Record id such as <scopeId>/0.",
            "minLength": 1,
            "type": "string"
          },
          "scope": {
            "description": "Use only global records or only the current Git project. Default: both.",
            "enum": ["global", "project"],
            "type": "string"
          }
        },
        "required": ["record"],
        "type": "object"
      },
      "name": "read"
    },
