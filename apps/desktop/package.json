{
  "name": "@mcp-cli/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "typecheck": "bun scripts/default-command.ts && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "desktop": "bun scripts/default-command.ts && tinyjs dev",
    "native:build": "bun scripts/default-command.ts && bun scripts/icons.ts && bun scripts/sounds.ts && tinyjs build",
    "test": "bun test test"
  },
  "dependencies": {
    "@mantine/core": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/modals": "9.7.1",
    "@mantine/notifications": "9.7.1",
    "@tabler/icons-react": "^3.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@txikijs/types": "^26.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
