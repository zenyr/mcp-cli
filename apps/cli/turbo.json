{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugins/*/package.json",
        "$TURBO_ROOT$/plugins/*/src/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugins/*/package.json",
        "$TURBO_ROOT$/plugins/*/src/**"
      ]
    }
  }
}
